# Comma-separated allowlist. Required in production; when omitted in local
# development, any authenticated Supabase user may call protected endpoints.
ADMIN_EMAILS="admin@example.com"

# Supabase Configuration
# Found in Supabase Dashboard -> Settings -> API
VITE_SUPABASE_URL="your_project_url"
VITE_SUPABASE_ANON_KEY="your_anon_key"

# Cloudflare R2 Configuration
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="gallery"
# The public URL of your bucket (Custom Domain or r2.dev URL)
VITE_R2_PUBLIC_URL="https://your-r2-public-url.com"

# Additional HTTPS hosts allowed when generating thumbnails from external URLs.
# The VITE_R2_PUBLIC_URL host is always allowed automatically.
THUMBNAIL_ALLOWED_HOSTS="images.example.com,cdn.example.com"
